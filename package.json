        },
        {
          "type": "font",
          "name": "FONT_RUSSO_26",
          "file": "fonts/RussoOne-Regular.ttf",
          "characterRegex": "[0-9:/%A-ZÁÉ-]"
        },
        {
          "type": "font",
          "name": "FONT_RUSSO_20",
          "file": "fonts/RussoOne-Regular.ttf",
          "characterRegex": "[0-9:/%A-ZÁÉ-]"
        }
      ]
    },
    "capabilities": [
      "health",
      "configurable"
    ]
  }
